{
  "name": "yidam-vscode",
  "displayName": "yidam",
  "description": "Editor surface for a yidam-derived knowledge repository.",
  "version": "0.1.0",
  "publisher": "goedelsoup",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/goedelsoup/yidam.git",
    "directory": "yidam/editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/goedelsoup/yidam/issues"
  },
  "homepage": "https://github.com/goedelsoup/yidam/tree/main/yidam/editors/vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "yidam",
    "knowledge graph",
    "corpus",
    "markdown"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.yidam.toml",
    "workspaceContains:.yidam/**"
  ],
  "contributes": {
    "configuration": {
      "title": "yidam",
      "properties": {
        "yidam.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `yidam` binary. Leave empty to resolve from `PATH`, then from the workspace's mise shims.\n\nThe extension never downloads or builds a binary: `.yidam.toml` records which yidam governs this corpus, and only it gets to say."
        },
        "yidam.lint.showBaselined": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show violations the committed baseline already records, as faded Hints.\n\nThey are inherited debt rather than regressions and never fail CI. A repository carrying a lot of it can turn them off — the debt is still in `.yidam/lint-baseline.yml` and still in the gate, so nothing a reader needs is lost."
        },
        "yidam.diagnostics.debounceMs": {
          "type": "number",
          "default": 400,
          "markdownDescription": "How long to wait after a save before re-running the reports. They walk the whole corpus per run."
        },
        "yidam.claims.decorate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Tint `[verified]` / `[inference]` / `[open]` inline, using the design system's claim palette.\n\nAlways off in high-contrast themes: a high-contrast theme is a stated accessibility choice, and tinting text against it overrides a decision the reader made deliberately."
        },
        "yidam.vendor.protect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mark `.yidam/.vendor/**` read-only in this workspace's `files.readonlyInclude`.\n\nThe vendored prelude is read-only by convention and, until now, by nothing else — an edit there works locally, survives review, and is silently discarded at the next `mise run yidam-vendor-update`. Fix prelude defects upstream and re-vendor.\n\nTurning this off removes the entry rather than setting it to `false`, so the setting is left as it was found."
        }
      }
    },
    "commands": [
      {
        "command": "yidam.showBinaryStatus",
        "title": "yidam: Show binary and contract status"
      },
      {
        "command": "yidam.refreshDiagnostics",
        "title": "yidam: Re-run lint and graph-check"
      },
      {
        "command": "yidam.blessBaseline",
        "title": "yidam: Bless the lint baseline"
      },
      {
        "command": "yidam.refreshViews",
        "title": "yidam: Refresh the views",
        "icon": "$(refresh)"
      },
      {
        "command": "yidam.checkoutPhase",
        "title": "yidam: Switch to a phase branch"
      },
      {
        "command": "yidam.regen",
        "title": "yidam: Refresh REGEN blocks (mise run regen)"
      },
      {
        "command": "yidam.buildIndex",
        "title": "yidam: Build the semantic index (mise run index-build)"
      },
      {
        "command": "yidam.vendorStatus",
        "title": "yidam: Check the vendored prelude against its pin"
      },
      {
        "command": "yidam.showHealth",
        "title": "yidam: Show repository health"
      },
      {
        "command": "yidam.applySchemaSettings",
        "title": "yidam: Apply the YAML schema settings"
      },
      {
        "command": "yidam.task.regen",
        "title": "yidam: Run task — regen"
      },
      {
        "command": "yidam.task.graph-check",
        "title": "yidam: Run task — graph-check"
      },
      {
        "command": "yidam.task.graph-lint",
        "title": "yidam: Run task — graph-lint"
      },
      {
        "command": "yidam.task.embed",
        "title": "yidam: Run task — embed"
      },
      {
        "command": "yidam.task.index-build",
        "title": "yidam: Run task — index-build"
      },
      {
        "command": "yidam.newNode",
        "title": "yidam: New corpus node"
      },
      {
        "command": "yidam.neighborhood",
        "title": "yidam: Show this node's neighbourhood"
      },
      {
        "command": "yidam.revealNode",
        "title": "yidam: Reveal this node in the Corpus view"
      },
      {
        "command": "yidam.neighborhoodOf",
        "title": "Show neighbourhood"
      },
      {
        "command": "yidam.newNodeIn",
        "title": "New node in this class"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yidam",
          "title": "yidam",
          "icon": "resources/yidam.svg"
        }
      ]
    },
    "views": {
      "yidam": [
        {
          "id": "yidam.corpus",
          "name": "Corpus"
        },
        {
          "id": "yidam.openQuestions",
          "name": "Open questions"
        },
        {
          "id": "yidam.phases",
          "name": "Phases"
        },
        {
          "id": "yidam.health",
          "name": "Health"
        },
        {
          "id": "yidam.sangha",
          "name": "Sangha",
          "when": "yidam.collective"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "yidam.refreshViews",
          "when": "view =~ /^yidam\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "yidam.neighborhoodOf",
          "when": "view == yidam.corpus && viewItem == yidam.node",
          "group": "navigation"
        },
        {
          "command": "yidam.neighborhoodOf",
          "when": "view == yidam.openQuestions && viewItem == yidam.openQuestion",
          "group": "navigation"
        },
        {
          "command": "yidam.newNodeIn",
          "when": "view == yidam.corpus && viewItem == yidam.class",
          "group": "navigation"
        },
        {
          "command": "yidam.checkoutPhase",
          "when": "view == yidam.phases && viewItem == yidam.phase",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "yidam.neighborhoodOf",
          "when": "false"
        },
        {
          "command": "yidam.newNodeIn",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "yidam",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The mise task from the inherited `mise.yidam.toml` layer."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "watch": "tsc -p . --watch",
    "lint": "eslint src test scripts --ext .ts",
    "test:unit": "node --test --experimental-strip-types test/*.test.ts",
    "vscode:prepublish": "npm run compile",
    "package": "node --experimental-strip-types scripts/check-package.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9",
    "ovsx": "^1.1.1",
    "smol-toml": "^1.3.0",
    "typescript": "^5.6"
  }
}
