{
  "name": "@goedelsoup/yidam-edit",
  "version": "0.1.0",
  "description": "Local authoring surface for a yidam-derived knowledge repository. Renders verdicts the yidam binary computes; computes none of its own.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "yidam-edit": "./bin/yidam-edit.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goedelsoup/yidam.git",
    "directory": "yidam/editors/web"
  },
  "bugs": {
    "url": "https://github.com/goedelsoup/yidam/issues"
  },
  "homepage": "https://github.com/goedelsoup/yidam/tree/main/yidam/editors/web#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "yidam",
    "knowledge graph",
    "corpus",
    "editor"
  ],
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "node ./bin/yidam-edit.mjs --no-open",
    "check": "astro check",
    "lint": "oxlint --deny-warnings .",
    "test:unit": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.mjs",
    "test": "npm run test:unit",
    "package": "node ./scripts/check-package.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "oxlint": "^1.83",
    "typescript": "^7.0.2"
  }
}
