\p ->
    let same : String -> String -> Bool = \a b -> a == b
    let pick name acc f =
        match acc with
        | Some found -> Some found
        | None -> if same f.path name then Some f.value else None
    let text : String -> Option String = \name ->
        match array.foldable.foldl (pick name) None p.fields with
        | Some (Text s) -> Some (string.trim s)
        | _ -> None
    let day : Option String =
        match text "feed/entry/published/#text" with
        | Some s -> if string.len s < 10 then Some s else Some (string.slice s 0 10)
        | None -> None
    let ids =
        match text "feed/entry/arxiv:doi/#text" with
        | Some d -> [{ key = "doi", value = d }]
        | None -> []
    { name = text "feed/entry/title/#text", kind = None, date = day, description = None, identifiers = ids }
