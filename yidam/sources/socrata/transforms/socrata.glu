\p ->
    let same : String -> String -> Bool = \a b -> a == b
    let pick name acc f =
        match acc with
        | Some found -> Some found
        | None -> if same f.path name then Some f.value else None
    let text : String -> Option String = \name ->
        match array.foldable.foldl (pick name) None p.fields with
        | Some (Text s) -> Some s
        | _ -> None
    let date =
        match text "dataUpdatedAt" with
        | Some s -> if string.len s < 10 then Some s else Some (string.slice s 0 10)
        | None -> None
    let ids =
        match text "domain" with
        | Some host ->
            match text "id" with
            | Some id -> [{ key = "rows", value = host ++ "/" ++ id }]
            | None -> []
        | None -> []
    { name = text "name", kind = None, date, description = text "description", identifiers = ids }
