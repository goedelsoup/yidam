      "--text-accent", "--text-base", "--text-disabled", "--text-inverse", "--text-lg",
      "--text-link", "--text-link-hover", "--text-primary", "--text-secondary",
      "--text-sm", "--text-tertiary", "--text-xl", "--text-xs",
