{
  "plugins": [
    "react",
    "import"
  ],
  "ignorePatterns": [
    "_ds_bundle.js",
    "index.js"
  ],
  "rules": {
    "react/forbid-elements": [
      "error",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/core/**",
              "**/feedback/**",
              "**/forms/**",
              "**/knowledge/**",
              "**/measurement/**",
              "**/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ]
  }
}
